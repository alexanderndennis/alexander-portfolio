---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Which nav item is the current page. */
  current?: 'home' | 'certifications' | 'awards' | 'memories';
}

const { title = site.title, description = site.description, current = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const nav = [
  { href: '/#story', label: 'Story' },
  { href: '/#build', label: 'Build' },
  { href: '/#lead', label: 'Leadership' },
  { href: '/#beyond', label: 'Beyond code' },
  { href: '/#roots', label: 'Roots' },
  { href: '/certifications/', label: 'Certifications', page: 'certifications' },
  { href: '/awards/', label: 'Awards', page: 'awards' },
  { href: '/#contact', label: 'Contact' },
];
const year = new Date().getFullYear();
const sameAs = [
  'https://www.linkedin.com/in/alexander-dennis-256198329',
  'https://github.com/alexanderndennis',
  'https://www.instagram.com/indian_cowboy__/',
];
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${site.url}/#person`,
  name: site.name,
  alternateName: ['Alexander Dennis', 'Alexander N Dennis', site.nickname],
  url: site.url,
  image: new URL(site.portrait.src, site.url).href,
  description: site.description,
  jobTitle: 'Full-Stack Engineer',
  nationality: { '@type': 'Country', name: 'Liberia' },
  homeLocation: { '@type': 'Place', name: 'Mohali, Punjab, India' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Chandigarh University' },
    { '@type': 'CollegeOrUniversity', name: 'Blue Crest University' },
  ],
  founder: { '@type': 'Organization', name: 'Avenor OS', url: 'https://church.avenoros.com' },
  memberOf: [
    { '@type': 'Organization', name: 'Chandigarh University Liberian Students Association (CULSA)', url: 'https://culsa.org/' },
    { '@type': 'Organization', name: 'Association of Liberian Students in India (ALSI)' },
    { '@type': 'SportsTeam', name: 'Elite Squad FC', url: 'https://www.instagram.com/elite_squad2025/' },
  ],
  knowsAbout: ['Full-stack development', 'React', 'NestJS', 'PostgreSQL', 'TypeScript', 'Multi-tenant SaaS'],
  sameAs,
};
const siteLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, author: { '@id': `${site.url}/#person` } };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#7E1F2E" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content={site.name} />
    <meta property="profile:first_name" content="Alexander" />
    <meta property="profile:last_name" content="Dennis" />
    <meta name="author" content={site.name} />
    <script type="application/ld+json" set:html={JSON.stringify(current === 'home' ? [personLd, siteLd] : siteLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Apply a saved theme before paint; otherwise follow the system setting. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="/"><img src={site.avatar} alt="" width="30" height="30" /><span>{site.name}</span></a>
        <nav class="nav" aria-label="Sections">
          {nav.map((n) => (
            <a href={n.href} aria-current={n.page && n.page === current ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="theme" id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span>&copy; {year} {site.name}</span>
        <span>{site.footerNote} <span class="star" aria-hidden="true"></span> {site.footerRoots}</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
      });
    </script>
  </body>
</html>
