---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, about, skills } from '../data/site';
import { projects } from '../data/projects';
import { experience } from '../data/experience';

const year = new Date().getFullYear();
---

<Base>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section id="top" class="mx-auto max-w-5xl px-4 pt-20 pb-16 sm:px-6 sm:pt-28">
      <p class="mb-3 text-sm font-medium text-accent-600 dark:text-accent-400">Hi, I'm</p>
      <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-6xl dark:text-white">{site.name}</h1>
      <p class="mt-3 text-xl text-slate-500 sm:text-2xl">{site.role}</p>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="rounded-lg bg-accent-600 px-5 py-2.5 font-medium text-white hover:bg-accent-500">View my work</a>
        <a href="#contact" class="rounded-lg border border-slate-300 px-5 py-2.5 font-medium hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:hover:text-accent-400">Get in touch</a>
      </div>
    </section>

    <Section id="about" title="About">
      <div class="grid gap-10 md:grid-cols-[3fr_2fr]">
        <div class="space-y-4 leading-relaxed">
          {about.map((p) => <p>{p}</p>)}
          <p class="text-sm text-slate-500">📍 {site.location}</p>
        </div>
        <div class="space-y-5">
          {skills.map((s) => (
            <div>
              <h3 class="mb-2 text-sm font-semibold text-slate-900 dark:text-white">{s.group}</h3>
              <ul class="flex flex-wrap gap-2">
                {s.items.map((i) => <li class="rounded-md border border-slate-200 px-2.5 py-1 text-sm dark:border-slate-800">{i}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Section>

    <Section id="projects" title="Projects">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </Section>

    <Section id="experience" title="Experience">
      <ol class="relative space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
        {experience.map((r) => (
          <li class="relative">
            <span class="absolute top-1.5 -left-[1.95rem] h-3 w-3 rounded-full border-2 border-white bg-accent-500 dark:border-slate-950" aria-hidden="true"></span>
            <p class="text-sm text-slate-500">{r.period}</p>
            <h3 class="font-semibold text-slate-900 dark:text-white">{r.title} · <span class="font-normal">{r.org}</span></h3>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
              {r.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </li>
        ))}
      </ol>
      {site.cvPath && (
        <a href={site.cvPath} download class="mt-10 inline-block rounded-lg border border-slate-300 px-5 py-2.5 font-medium hover:border-accent-500 hover:text-accent-600 dark:border-slate-700 dark:hover:text-accent-400">Download CV (PDF)</a>
      )}
    </Section>

    <Section id="contact" title="Contact">
      <p class="max-w-xl text-lg leading-relaxed">Have a project, role, or idea in mind? My inbox is open — I'll get back to you as soon as I can.</p>
      <a href={`mailto:${site.email}`} class="mt-6 inline-block rounded-lg bg-accent-600 px-5 py-2.5 font-medium text-white hover:bg-accent-500">{site.email}</a>
      <ul class="mt-6 flex gap-5">
        {site.socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener me" class="hover:text-accent-600 dark:hover:text-accent-400">{s.label} ↗</a></li>
        ))}
      </ul>
    </Section>
  </main>

  <footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500 dark:border-slate-800">
    © {year} {site.name}. Built with Astro.
  </footer>
</Base>
