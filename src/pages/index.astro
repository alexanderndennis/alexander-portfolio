---
import Base from '../layouts/Base.astro';
import { site, story, skills, beyond, faith, contact } from '../data/site';
import { flagship, sideProjects } from '../data/projects';
import { leadership, experience, education } from '../data/experience';
import { galleries } from '../data/galleries';
---

<Base>
  <section class="hero" aria-labelledby="hero-name">
    <div class="bigstar" aria-hidden="true"><span class="star"></span></div>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow"><span class="star" aria-hidden="true"></span>&nbsp; {site.origin}</p>
        <h1 id="hero-name">{site.name}<span class="nick">a.k.a. {site.nickname}</span></h1>
        <p class="lede" set:html={site.lede} />
        <ul class="roles">{site.roles.map((r) => <li>{r}</li>)}</ul>
        <div class="cta">
          <a class="btn btn-light" href="#build">See what I&rsquo;ve built</a>
          <a class="btn btn-ghost" href="#contact">Get in touch</a>
        </div>
      </div>
      <figure class="portrait">
        <img src={site.portrait.src} alt={site.portrait.alt} width="720" height="960" fetchpriority="high" />
        <figcaption class="tag"><b>{site.portrait.tagTitle}</b>{site.portrait.tagText}</figcaption>
      </figure>
    </div>
  </section>

  <div class="facts">
    <div class="wrap">
      {site.facts.map((f) => <div class="fact"><b>{f.value}</b><span>{f.label}</span></div>)}
    </div>
  </div>

  <section class="ch" id="story" aria-labelledby="h-story">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 1</p>
        <div><h2 id="h-story">{story.heading}</h2></div>
      </div>
      <div class="ch-body">
        <div class="side">{story.places}</div>
        <div class="prose">
          {story.paragraphs.map((p) => <p set:html={p} />)}
          <blockquote class="credo">&ldquo;{story.credo.quote}&rdquo;<cite>{story.credo.cite}</cite></blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="ch" id="build" aria-labelledby="h-build">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 2 &middot; Work</p>
        <div>
          <h2 id="h-build">Products I&rsquo;ve built end to end</h2>
          <p>Product thinking, architecture, database design, API, front end and deployment. Most of my work lives on <a href={site.github} target="_blank" rel="noopener">GitHub</a>.</p>
        </div>
      </div>

      <article class="flag">
        <div class="flag-head">
          <p class="eyebrow">{flagship.eyebrow}</p>
          <h3>{flagship.name}</h3>
          <p>{flagship.summary}</p>
        </div>
        <div class="products">
          {flagship.products.map((p) => (
            <div class="product">
              <h4>{p.name} <span class={`status ${p.status}`}>{p.statusLabel}</span></h4>
              {p.intro && <p class="intro">{p.intro}</p>}
              <ul>{p.points.map((pt) => <li set:html={pt} />)}</ul>
              <ul class="stack" aria-label="Tech stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
              <div class="links">
                {p.links?.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
                {p.note && <span class="note" set:html={p.note} />}
              </div>
            </div>
          ))}
        </div>
      </article>

      {sideProjects.map((p) => (
        <div class="side-project">
          <div class="product">
            <h4>{p.name} <span class={`status ${p.status}`}>{p.statusLabel}</span></h4>
            {p.intro && <p class="intro">{p.intro}</p>}
            <ul>{p.points.map((pt) => <li set:html={pt} />)}</ul>
            <ul class="stack" aria-label="Tech stack">{p.stack.map((s) => <li>{s}</li>)}</ul>
            {p.links && (
              <div class="links">{p.links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</div>
            )}
          </div>
          {p.diagram && (
            <div class="product">
              <p class="eyebrow">{p.diagramLabel}</p>
              <pre class="erd">{p.diagram}</pre>
            </div>
          )}
          {p.photo && (
            <div class="product">
              <figure class="side-photo">
                <img src={p.photo.src} alt={p.photo.alt} loading="lazy" decoding="async" />
                {p.photo.caption && <figcaption>{p.photo.caption}</figcaption>}
              </figure>
            </div>
          )}
        </div>
      ))}

      <div class="skills">
        {skills.map((s) => (
          <div><h3>{s.group}</h3><ul>{s.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="ch" id="lead" aria-labelledby="h-lead">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 3 &middot; Leadership</p>
        <div><h2 id="h-lead">{leadership.heading}</h2><p>{leadership.intro}</p></div>
      </div>
      <ol class="timeline">
        {experience.map((r) => (
          <li class={r.key ? 'key' : undefined}>
            <span class="when">{r.when}</span>
            <span class="dot" aria-hidden="true"></span>
            <div>
              <h3>{r.title}{r.badge && <span class={`badge ${r.badge}`}><span class="star" aria-hidden="true"></span> {r.badge === 'elected' ? 'Elected' : 'Appointed'}</span>}</h3>
              <p class="org">{r.org}</p>
              {r.text && <p>{r.text}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="ch" id="beyond" aria-labelledby="h-beyond">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 4 &middot; Beyond code</p>
        <div><h2 id="h-beyond">On the pitch, on camera, on campus</h2></div>
      </div>
      <div class="trio">
        {beyond.map((b) => (
          <div class="panel">
            <p class="eyebrow">{b.eyebrow}</p>
            <div class="big">{b.big}</div>
            <h3>{b.title}</h3>
            <p>{b.text}</p>
            {b.link && <a class="handle" href={b.link.href} target="_blank" rel="noopener">{b.link.label}</a>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ch" id="roots" aria-labelledby="h-roots">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 5 &middot; Roots</p>
        <div><h2 id="h-roots">Education and faith</h2></div>
      </div>
      <div class="roots">
        <ul class="edu">
          {education.map((e) => (
            <li>
              <h3>{e.school}</h3><span class="yr">{e.years}</span>
              <p>{e.detail}</p>
              {e.ranks && <div class="rank">{e.ranks.map((r) => <span>{r}</span>)}</div>}
            </li>
          ))}
        </ul>
        <div class="panel">
          <p class="eyebrow">Faith &amp; service</p>
          <ul>{faith.items.map((i) => <li set:html={i} />)}</ul>
          <blockquote class="credo sm">&ldquo;{faith.credo.quote}&rdquo;<cite>{faith.credo.cite}</cite></blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="ch" id="proof" aria-labelledby="h-proof">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Proof of work</p>
        <div><h2 id="h-proof">Certificates, honours and memories</h2><p>Every course, award and moment worth remembering, kept in one place.</p></div>
      </div>
      <div class="teasers">
        {galleries.map((g) => (
          <a class="teaser" href={`/${g.slug}/`}>
            <p class="eyebrow">{g.teaserEyebrow}</p>
            <h3>{g.title}</h3>
            <p>{g.teaserText}</p>
            <span class="go">
              Open gallery{g.items.length > 0 && ` · ${g.items.length} item${g.items.length === 1 ? '' : 's'}`} &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ch contact" id="contact" aria-labelledby="h-contact">
    <div class="wrap">
      <div class="ch-head">
        <p class="eyebrow">Chapter 6 &middot; Contact</p>
        <div><h2 id="h-contact">{contact.heading}</h2><p>{contact.intro}</p></div>
      </div>
      <div class="ch-body">
        <div></div>
        <div>
          <div class="mail-rows">
            {contact.emails.map((m) => (
              <div class="mail">
                <span class="who">{m.label}</span>
                <a class="addr" href={`mailto:${m.address}`}>{m.address}</a>
                <button class="copy" type="button" data-copy={m.address} aria-label={`Copy ${m.address}`}>Copy</button>
              </div>
            ))}
          </div>
          <div class="socials">
            {contact.socials.map((s) => <a href={s.href} target="_blank" rel="noopener me">{s.label}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
    if (!btn) return;
    const text = btn.dataset.copy!;
    const done = () => { btn.textContent = 'Copied'; setTimeout(() => (btn.textContent = 'Copy'), 1600); };
    const fallback = () => {
      const addr = btn.parentElement?.querySelector('.addr');
      if (!addr) return;
      const r = document.createRange(); r.selectNodeContents(addr);
      const s = getSelection(); s?.removeAllRanges(); s?.addRange(r);
      btn.textContent = 'Press Ctrl+C';
    };
    try { navigator.clipboard.writeText(text).then(done, fallback); } catch { fallback(); }
  });
</script>
