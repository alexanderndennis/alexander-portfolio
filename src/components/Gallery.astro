---
import Base from '../layouts/Base.astro';
import type { Gallery, GalleryItem } from '../data/galleries';
import { site } from '../data/site';

interface Props { gallery: Gallery }
const { gallery: g } = Astro.props;

const fmtDate = (d?: string) => {
  if (!d) return '';
  const [y, m] = d.split('-');
  return m
    ? new Date(Date.UTC(+y, +m - 1, 1)).toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : y;
};
const items = g.order === 'manual' ? g.items : [...g.items].sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const cats = g.cats.filter((c) => items.some((i) => i.cat === c));
const sub = (i: GalleryItem) => [i.issuer, fmtDate(i.date)].filter(Boolean).join(' · ');
/** Award and memory photos ship with a small "-t.jpg" thumbnail beside them. */
const thumb = (src: string) => (/^\/(awards|memories)\//.test(src) ? src.replace(/\.jpg$/, '-t.jpg') : src);
const photos = (i: GalleryItem) => (i.image ? [i.image, ...(i.images ?? [])] : []);
const wall = g.layout === 'wall';
const tiles = wall ? items.flatMap((i) => photos(i).map((src) => ({ src, cat: i.cat, alt: i.title }))) : [];
const total = wall ? tiles.length : items.length;
const unit = wall ? 'photo' : 'item';
---

<Base title={`${g.title} · ${site.name}`} description={g.desc} current={g.slug}>
  <div class="view-head">
    <div class="wrap">
      <a class="back" href="/">&larr; Back to portfolio</a>
      <p class="eyebrow">{g.eyebrow}</p>
      <h1>{g.title}</h1>
      <p>{g.desc}</p>
    </div>
  </div>
  <div class="wrap">
    <div class="toolbar" id="filters">
      {items.length > 0 && cats.length > 1 && (
        <>
          <button class="filter" aria-pressed="true" data-f="All">All</button>
          {cats.map((c) => <button class="filter" aria-pressed="false" data-f={c}>{c}</button>)}
        </>
      )}
      <span class="count" id="count" data-unit={unit}>{total} {unit}{total === 1 ? '' : 's'}</span>
    </div>
    {wall ? (
      <div class="wall" id="grid">
        {tiles.map((t) => (
          <button class="tile card" type="button" data-cat={t.cat} data-full={t.src} aria-label="View photo">
            <img loading="lazy" decoding="async" src={thumb(t.src)} alt={t.alt} />
          </button>
        ))}
      </div>
    ) : (
    <div class={`grid${g.fit === 'contain' ? ' fit-contain' : ''}`} id="grid">
      {items.length === 0 && (
        <div class="empty"><b>Nothing here yet</b><span>New items will appear here soon.</span></div>
      )}
      {items.map((i) => {
        const ps = photos(i);
        return (
          <article class="card" data-cat={i.cat}>
            {ps.length > 0 ? (
              <button class="thumb" type="button" data-photos={JSON.stringify(ps)} data-cap={[i.title, sub(i)].filter(Boolean).join(' · ')}
                aria-label={`View ${ps.length > 1 ? `${ps.length} photos of` : ''} ${i.title}`}>
                <img loading="lazy" decoding="async" src={thumb(ps[0])} alt={i.title} />
                {ps.length > 1 && <span class="pcount" aria-hidden="true">{ps.length} photos</span>}
              </button>
            ) : (
              <div class="ph" aria-hidden="true"><span class="star"></span></div>
            )}
            <div class="meta">
              <span class="tagcat">{i.cat}</span>
              <h3>{i.title}</h3>
              {sub(i) && <span class="sub">{sub(i)}</span>}
              {i.note && <p class="note">{i.note}</p>}
            </div>
          </article>
        );
      })}
    </div>
    )}
  </div>

  <div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="x" id="lb-close" type="button">Close</button>
    <button class="nav-btn prev" id="lb-prev" type="button" aria-label="Previous photo">&#8249;</button>
    <figure><img id="lb-img" alt="" /><figcaption><span id="lb-cap"></span> <span id="lb-pos" class="pos"></span></figcaption></figure>
    <button class="nav-btn next" id="lb-next" type="button" aria-label="Next photo">&#8250;</button>
  </div>
</Base>

<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = $('#count');

  document.getElementById('filters')?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-f]');
    if (!b) return;
    const f = b.dataset.f;
    document.querySelectorAll('[data-f]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    let n = 0;
    cards.forEach((c) => { const show = f === 'All' || c.dataset.cat === f; c.hidden = !show; if (show) n++; });
    const u = count.dataset.unit; count.textContent = `${n} ${u}${n === 1 ? '' : 's'}`;
  });

  const lb = $('#lightbox'), img = $<HTMLImageElement>('#lb-img'), cap = $('#lb-cap'), pos = $('#lb-pos');
  const close = $('#lb-close'), prev = $<HTMLButtonElement>('#lb-prev'), next = $<HTMLButtonElement>('#lb-next');
  let opener: HTMLElement | null = null, list: string[] = [], at = 0, title = '';

  const show = (k: number) => {
    at = (k + list.length) % list.length;
    img.src = list[at]; img.alt = `${title} (photo ${at + 1} of ${list.length})`;
    pos.textContent = list.length > 1 ? `${at + 1} / ${list.length}` : '';
    if (list.length > 1) new Image().src = list[(at + 1) % list.length];
  };
  const hide = () => { lb.hidden = true; document.body.style.overflow = ''; opener?.focus(); };

  document.getElementById('grid')?.addEventListener('click', (e) => {
    const tile = (e.target as HTMLElement).closest<HTMLButtonElement>('.tile');
    if (tile) {
      const shown = cards.filter((c) => !c.hidden) as HTMLButtonElement[];
      opener = tile; list = shown.map((c) => c.dataset.full!); title = 'Memory';
      cap.textContent = ''; prev.hidden = next.hidden = list.length < 2;
      show(shown.indexOf(tile)); lb.hidden = false; document.body.style.overflow = 'hidden'; close.focus();
      return;
    }
    const t = (e.target as HTMLElement).closest<HTMLButtonElement>('.thumb');
    if (!t) return;
    opener = t; list = JSON.parse(t.dataset.photos!); title = t.dataset.cap ?? '';
    cap.textContent = title; prev.hidden = next.hidden = list.length < 2;
    show(0); lb.hidden = false; document.body.style.overflow = 'hidden'; close.focus();
  });
  prev.addEventListener('click', () => show(at - 1));
  next.addEventListener('click', () => show(at + 1));
  close.addEventListener('click', hide);
  lb.addEventListener('click', (e) => { if (e.target === lb) hide(); });
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') hide();
    else if (e.key === 'ArrowLeft' && list.length > 1) show(at - 1);
    else if (e.key === 'ArrowRight' && list.length > 1) show(at + 1);
  });
  let x0: number | null = null;
  lb.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener('touchend', (e) => {
    if (x0 === null || list.length < 2) return;
    const dx = e.changedTouches[0].clientX - x0; x0 = null;
    if (Math.abs(dx) > 40) show(at + (dx < 0 ? 1 : -1));
  }, { passive: true });
</script>
