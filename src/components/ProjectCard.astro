---
import type { Project } from '../data/projects';
interface Props { project: Project; }
const { project: p } = Astro.props;
---
<article class="flex flex-col rounded-xl border border-slate-200 p-6 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:hover:shadow-black/40">
  <div class="mb-2 flex items-center gap-2">
    <h3 class="text-lg font-semibold text-slate-900 dark:text-white">{p.title}</h3>
    {p.featured && <span class="rounded-full bg-accent-50 px-2 py-0.5 text-xs font-medium text-accent-600 dark:bg-accent-600/15 dark:text-accent-400">Featured</span>}
  </div>
  <p class="mb-3 text-xs uppercase tracking-wide text-slate-500">{p.role}</p>
  <p class="mb-4 flex-1 text-sm leading-relaxed">{p.summary}</p>
  <ul class="mb-4 flex flex-wrap gap-2" aria-label="Technologies">
    {p.tech.map((t) => <li class="rounded-md bg-slate-100 px-2 py-1 text-xs dark:bg-slate-800">{t}</li>)}
  </ul>
  {(p.live || p.code) && (
    <div class="flex gap-4 text-sm font-medium">
      {p.live && <a href={p.live} target="_blank" rel="noopener" class="text-accent-600 hover:underline dark:text-accent-400">Live site<span class="sr-only"> for {p.title}</span> ↗</a>}
      {p.code && <a href={p.code} target="_blank" rel="noopener" class="text-accent-600 hover:underline dark:text-accent-400">Source<span class="sr-only"> for {p.title}</span> ↗</a>}
    </div>
  )}
</article>
