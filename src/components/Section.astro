---
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
---
<section id={id} class="mx-auto max-w-5xl px-4 py-16 sm:px-6 sm:py-20" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="mb-8 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl dark:text-white">{title}</h2>
  <slot />
</section>
